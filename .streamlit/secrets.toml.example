# Holds the two publish buttons. Visitors read, score, chat and send verdicts
# without it; only a link carrying ?k=<this> may replace the live rules.
EDITOR_KEY = "a long random string"

[connections.supabase]
SUPABASE_URL = "https://<ref>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # publishable key only
