# Optional. Holds the two publish buttons: only a link carrying ?k=<this> may
# replace the live rules; visitors read, score, chat and send verdicts without it.
# Leave it out and the key is derived from the Supabase key below, so a deployment
# is gated without anyone editing its secrets. With no secrets at all, nobody
# publishes.
# EDITOR_KEY = "a long random string"

[connections.supabase]
SUPABASE_URL = "https://<ref>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # publishable key only
